{
  "version": 1,
  "id": "heldout-invoice-import-v1",
  "title": "Authored invoice import: exact customer references",
  "contract": {
    "version": 1,
    "schema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "batchId",
        "customers",
        "invoices"
      ],
      "properties": {
        "batchId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "customers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "externalId",
              "email"
            ],
            "properties": {
              "externalId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "email": {
                "type": "string",
                "format": "email"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              }
            }
          }
        },
        "invoices": {
          "type": "array",
          "minItems": 1,
          "maxItems": 40,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "invoiceId",
              "customerExternalId",
              "amountCents",
              "currency",
              "dueDate"
            ],
            "properties": {
              "invoiceId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "customerExternalId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "amountCents": {
                "type": "number",
                "minimum": 1,
                "maximum": 100000000,
                "integer": true
              },
              "currency": {
                "type": "string",
                "enum": [
                  "USD",
                  "EUR",
                  "GBP"
                ],
                "public": true
              },
              "dueDate": {
                "type": "string",
                "format": "date"
              },
              "memo": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              }
            }
          }
        },
        "note": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "caseToken": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      }
    },
    "relations": [
      {
        "left": "/invoices/0/customerExternalId",
        "operator": "eq",
        "right": "/customers/0/externalId"
      }
    ]
  },
  "oracle": {
    "version": 1,
    "id": "heldout-invoice-import-v1",
    "assertionId": "invoice-import.preserves-customer-reference.v1",
    "failureKind": "valid-import-reference-resolution",
    "failureSite": "invoice-import.resolve-customer.v1",
    "affected": {
      "revision": "invoice-import-truncation-before-v1",
      "command": [
        "node",
        "examples/heldout/adapter.mjs",
        "affected",
        "{input}"
      ],
      "files": [
        {
          "path": "examples/heldout/app.mjs",
          "sha256": "e6d8f1796e1c7ececf94617c4d0569e1796308df65eba6430678872f923d516b"
        },
        {
          "path": "examples/heldout/adapter.mjs",
          "sha256": "ec2b3b35b48dff207c3eec3ff937ec81436ae15362283699331f8c8739cb809e"
        }
      ]
    },
    "limits": {
      "timeoutMs": 5000,
      "maxOutputBytes": 4096
    },
    "fixed": {
      "revision": "invoice-import-exact-lookup-v1",
      "command": [
        "node",
        "examples/heldout/adapter.mjs",
        "fixed",
        "{input}"
      ],
      "files": [
        {
          "path": "examples/heldout/app.mjs",
          "sha256": "e6d8f1796e1c7ececf94617c4d0569e1796308df65eba6430678872f923d516b"
        },
        {
          "path": "examples/heldout/adapter.mjs",
          "sha256": "ec2b3b35b48dff207c3eec3ff937ec81436ae15362283699331f8c8739cb809e"
        }
      ]
    }
  },
  "budget": {
    "maxRuns": 48,
    "maxDurationMs": 45000,
    "repeats": 2
  }
}
